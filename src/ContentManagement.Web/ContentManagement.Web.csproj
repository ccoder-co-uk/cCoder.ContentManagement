<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NETSDK1233</WarningsNotAsErrors>
    <UseLocalData Condition="'$(UseLocalData)' == ''">false</UseLocalData>
    <UseLocalData Condition="'$(UseLocalData)' == 'true' and !Exists('$(LocalDataProject)')">false</UseLocalData>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="cCoder.CodeAnalysis" Version="2026.10.8.1211" IncludeAssets="analyzers;build;buildTransitive" PrivateAssets="all" />
    <PackageReference Include="cCoder.CodeAnalysis.Contracts" Version="2026.10.8.1211" />
    <PackageReference Include="BuildBundlerMinifier" Version="3.2.449" />
    <PackageReference Include="Microsoft.AspNetCore.OData" Version="9.5.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.SqlServer" Version="10.0.12" />
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.2.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.2.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    <PackageReference Include="cCoder.AppSecurity" Version="2026.10.8.1310" />
    <PackageReference Include="cCoder.Eventing" Version="2026.10.8.1222" />
    <PackageReference Include="cCoder.Eventing.AzureServiceBus" Version="2026.10.8.1222" />
    <PackageReference Include="cCoder.Eventing.Http" Version="2026.10.8.1222" />
    <PackageReference Include="cCoder.Security" Version="2026.10.8.1235" />
    <PackageReference Include="cCoder.Security.Data" Version="2026.10.8.1235" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\cCoder.ContentManagement\cCoder.ContentManagement.csproj" AdditionalProperties="UseLocalData=$(UseLocalData);LocalDataProject=$(LocalDataProject)" />
  </ItemGroup>
</Project>
